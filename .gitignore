# ==============================================================================
# Adaptive LiDAR Lab - Git Ignore Configuration
# ==============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs (except detector evaluation benchmark logs in results/)
*.log
!results/detector_evaluation/logs/*.log
!results/logs/*.log

# Node / Frontend dependencies
node_modules/
app/frontend/node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Large Datasets & Binary Point Clouds (>30 GB)
# Note: Raw KITTI LiDAR .bin files and zip archives must be downloaded separately
# from the official KITTI Vision Benchmark Suite.
data/
dataset/
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.bin
*.pth

# OS & Editor generated files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
ScreenCapture_*.png
ScreenCamera_*.json
backup/
*.backup
